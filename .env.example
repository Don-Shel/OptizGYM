# Neon Auth — obtain these values from the Neon Console
NEON_AUTH_URL=https://<neon-auth-host>/neondb/auth
NEON_JWKS_URL=https://<neon-auth-host>/neondb/auth/.well-known/jwks.json
# Exact JWT `iss` and `aud` values from Neon Auth; required in production.
NEON_AUTH_ISSUER=https://<neon-auth-host>/neondb/auth
NEON_AUTH_AUDIENCE=replace_with_neon_auth_audience

# Frontend-only configuration (these values are bundled into the browser build)
# Auth URL and API origin are public configuration; keep server secrets below.
VITE_NEON_AUTH_URL=https://<neon-auth-host>/neondb/auth
VITE_API_URL=http://localhost:3001

# Paystack Payments
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Optional isolated test pricing. When enabled, test checkout uses the original KES 1,500 / 3,500 / 7,500 plan prices.
# Keep false or unset for normal production membership pricing.
VITE_PAYMENT_TEST_MODE=false
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Set true only on an isolated Paystack test API deployment to match VITE_PAYMENT_TEST_MODE.
PAYMENT_TEST_MODE=false

# Neon Database — server-side only
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require
PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Comma-separated list of frontend origins. In production include both current Vercel aliases.
# FRONTEND_URL=https://optibizgym.vercel.app,https://optizgym.vercel.app
FRONTEND_URL=http://localhost:8080

# Neon webhook verification
# Reject requests whose timestamp is older/newer than this window.
NEON_WEBHOOK_MAX_AGE_MS=300000

# Node Environment
NODE_ENV=development
LOG_LEVEL=info
# Set true only when a writable logs/ directory is available.
LOG_TO_FILE=false
